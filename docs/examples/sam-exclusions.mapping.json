{
  "format": "csv",
  "id": "SAM Number",
  "keys": [
    {"paths": ["First", "Middle", "Last"]},
    {"path": "Name"}
  ],
  "payload": {
    "classification": "Classification",
    "program": "Exclusion Program",
    "agency": "Excluding Agency",
    "excl_type": "Exclusion Type",
    "active_date": "Active Date",
    "uei": "UEI",
    "npi": "NPI"
  },
  "list": {
    "analyzer": {"preset": "person-name"},
    "match": {"mode": "ngram", "grams": [2, 3], "strip_spaces": true, "threshold": 0.6, "topk": 100}
  }
}
